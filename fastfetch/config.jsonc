{
  // fastfetch config - custom logo + per-line kitty image icons
  // icons: ~/.config/fastfetch/icons/*.png (256x128 px, rendered 2x1 cells)
  "logo": {
    "type": "kitty-direct",
    "source": "/home/black/.config/fastfetch/logo.png",
    "width": 20,
    "height": 26,
    "preserveAspectRatio": true,
    "padding": { "left": 2, "right": 4, "top": 1 }
  },
  "display": {
    "separator": ": ",
    // key.width = icon(2) + space + longest key, so values line up
    "key": { "width": 25, "type": "both" }
  },
  "modules": [
    { "type": "title" },
    { "type": "separator" },
    { "type": "os", "keyIcon": "\u001b_Ga=T,f=100,t=f,i=1,c=2,r=1,C=1,q=2;L2hvbWUvYmxhY2svLmNvbmZpZy9mYXN0ZmV0Y2gvaWNvbnMvb3MucG5n\u001b\\\u001b[2C" },
